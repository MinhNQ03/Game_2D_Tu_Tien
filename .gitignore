# Godot 4+ specific ignores
.godot/
/android/

# Python bytecode. `tools/gen_prototype_assets.py` is importable (the art preview harness
# imports it), so CPython writes a __pycache__ next to it on every run.
__pycache__/
*.pyc

# Agent/CI scratch files (never commit). The `_` prefix is the agreed scratch convention
# (L-009): naming a helper `_probe.ps1` / `_out_x.log` makes it ignored by construction
# instead of relying on remembering to delete it.
_*.ps1
_*.log
*_tmp.txt
alive_probe.txt
commit_result.txt
push_result.txt
gitlog_tmp.txt

# Upstream asset SOURCE PACKS kept locally as design reference (D-056 §40).
#
# Classified, not ignored blindly: both packs carry an explicit CC0 1.0 licence file, and
# `docs/ASSET_LICENSES.md` records the classification and where the promoted subset lives.
# They stay OUT of git and OUT of `res://` because they are 34MB of upstream material from
# which exactly three files were ever promoted — those three are tracked under
# `assets/ui/kenney_borders/`. Nothing in the project references this directory.
#
# An asset whose licence is UNCLEAR must never enter `res://` at all; that rule is unchanged
# and these two are not that case.
docs/design_refs/
