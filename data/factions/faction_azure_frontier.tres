[gd_resource type="Resource" script_class="FactionTemplateData" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/data/factions/faction_template_data.gd" id="1_tmpl"]
[ext_resource type="Script" path="res://src/data/factions/faction_goal_data.gd" id="2_goal"]

[sub_resource type="Resource" id="goal_seek_unallocated"]
script = ExtResource("2_goal")
goal_id = &"goal_seek_unallocated"
name_key = &"FACTION_GOAL_SEEK_UNALLOCATED"
kind = 3
priority = 3

[sub_resource type="Resource" id="goal_fund_expeditions"]
script = ExtResource("2_goal")
goal_id = &"goal_fund_expeditions"
name_key = &"FACTION_GOAL_FUND_EXPEDITIONS"
kind = 2
priority = 2

[resource]
script = ExtResource("1_tmpl")
id = &"faction_azure_frontier"
parent_sect_id = &"sect_azure_cloud"
name_key = &"FACTION_AZURE_FRONTIER_NAME"
doctrine_key = &"FACTION_AZURE_FRONTIER_DOCTRINE"
emblem_ref = ""
stance = 2
goals = [SubResource("goal_seek_unallocated"), SubResource("goal_fund_expeditions")]
influence_seed = 31
starting_resources = {
"spirit_stones": 95,
"manpower": 60
}
default_allied_faction_ids = []
default_rival_faction_ids = [&"faction_azure_terrace"]
