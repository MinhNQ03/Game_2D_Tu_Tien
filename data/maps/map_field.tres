[gd_resource type="Resource" script_class="MapData" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/data/maps/map_data.gd" id="1_mapdata"]
[ext_resource type="Script" path="res://src/data/maps/map_exit.gd" id="2_mapexit"]

[sub_resource type="Resource" id="MapExit_to_hub"]
script = ExtResource("2_mapexit")
id = &"exit_to_hub"
to_map_id = &"map_hub"
entry_point = &"from_field"

[resource]
script = ExtResource("1_mapdata")
id = &"map_field"
name_key = "UI_MAP_FIELD_NAME"
scene_key = "map_field"
scene_path = "res://src/gameplay/maps/field_map.tscn"
bounds = Rect2(16, 16, 448, 288)
default_spawn_id = &"spawn_default"
exits = [SubResource("MapExit_to_hub")]
