rules = [SubResource("rule_helped_stranger"), SubResource("rule_kept_promise"), SubResource("rule_broke_promise"), SubResource("rule_won_fair_duel"), SubResource("rule_saved_debtor"), SubResource("rule_intimidated_weak")]
